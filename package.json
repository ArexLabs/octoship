{
  "name": "@ims/octoship",
  "version": "1.0.0-ALPHA",
  "author": {
    "email": "itzzmateo@devflare.de",
    "name": "ItzzMateo",
    "url": "https://github.com/itzzjustmateo"
  },
  "repository": "https://github.com/ArexLabs/octoship",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "bin": {
    "octoship": "./dist/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@octokit/openapi-types": "^27.0.0",
    "@types/bun": "latest",
    "citty": "^0.2.2",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "msw": "^2.15.0",
    "tsup": "^8.5.1",
    "ultracite": "7.9.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/ArexLabs/octoship/issues"
  },
  "description": "Fetch any release of any GitHub Repository",
  "files": [
    "dist"
  ],
  "homepage": "https://devflare.de",
  "keywords": [
    "releases",
    "github",
    "octoship"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "type": "module",
  "types": "dist/index.d.ts"
}
